# Template file for 'event-horizon'
pkgname=event-horizon
version=0.1.5
revision=1
build_style=gnu-makefile
# Upstream uses zig build; this template invokes zig directly.
hostmakedepends="zig pkg-config wayland-devel"
makedepends="wayland-devel wayland-protocols libxkbcommon-devel cairo-devel
 pango-devel librsvg-devel libwebp-devel pipewire-devel pam-devel"
depends="zenity"
short_desc="Event Horizon - Wayland desktop shell written in Zig"
maintainer="visadaking <yahalom.mauni@protonmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/visadaking/Event-Horizon"
distfiles="https://github.com/visadaking/Event-Horizon/archive/refs/tags/v${version}.tar.gz"
checksum=SKIP

# Zig >= 0.16.0 required. Ensure host zig meets minimum or provide a compatible zig.

do_build() {
	zig build -Doptimize=ReleaseFast
}

do_install() {
	# install binaries
	vbin zig-out/bin/horizon
	vbin zig-out/bin/eh-ipc
	vbin zig-out/bin/horizon-wallpaper
	vbin zig-out/bin/horizon-dock
	vbin zig-out/bin/horizon-settings
	vbin zig-out/bin/horizon-audio-center
	vbin zig-out/bin/horizon-overview
	vbin zig-out/bin/horizon-desktop-widgets
	vbin zig-out/bin/horizon-notifications
	vbin zig-out/bin/horizon-polkit-agent
	vbin zig-out/bin/horizon-taskbar
	vbin zig-out/bin/horizon-desktop
	vbin zig-out/bin/horizonClipboardDaemon
	vbin zig-out/bin/horizon-clipstack
	vbin zig-out/bin/horizon-clipstack-pick
	vbin zig-out/bin/horizon-idle
	vbin zig-out/bin/horizon-lock

	vdoc README.md
	vdoc CHANGELOG.md
}
