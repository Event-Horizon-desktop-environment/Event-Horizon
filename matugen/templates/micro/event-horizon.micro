color-link default "#{{colors.on_surface.default.hex}},#{{colors.surface.default.hex}}"
color-link comment "#{{colors.on_surface_variant.default.hex}},#{{colors.surface.default.hex}}"
color-link identifier "#{{colors.primary.default.hex}},#{{colors.surface.default.hex}}"
color-link constant "#{{colors.tertiary.default.hex}},#{{colors.surface.default.hex}}"
color-link statement "#{{colors.secondary.default.hex}},#{{colors.surface.default.hex}}"
color-link symbol "#{{colors.on_surface_variant.default.hex}},#{{colors.surface.default.hex}}"
color-link preproc "#{{colors.primary_container.default.hex}},#{{colors.surface.default.hex}}"
color-link type "#{{colors.secondary.default.hex}},#{{colors.surface.default.hex}}"
color-link special "#{{colors.tertiary.default.hex}},#{{colors.surface.default.hex}}"
color-link underlined "underline #{{colors.on_surface.default.hex}},#{{colors.surface.default.hex}}"
color-link error "bold #{{colors.error.default.hex}},#{{colors.surface.default.hex}}"
color-link todo "bold #{{colors.on_tertiary_container.default.hex}},#{{colors.tertiary_container.default.hex}}"
color-link selection "#{{colors.on_primary.default.hex}},#{{colors.primary.default.hex}}"
color-link statusline "bold #{{colors.on_surface.default.hex}},#{{colors.surface_container_high.default.hex}}"
color-link statusline.inactive "#{{colors.on_surface_variant.default.hex}},#{{colors.surface_container.default.hex}}"
color-link statusline.suggestions "#{{colors.on_secondary_container.default.hex}},#{{colors.secondary_container.default.hex}}"
color-link tabbar "#{{colors.on_surface_variant.default.hex}},#{{colors.surface_container_low.default.hex}}"
color-link tabbar.active "bold #{{colors.on_primary.default.hex}},#{{colors.primary.default.hex}}"
color-link indent-char "#{{colors.outline.default.hex}},#{{colors.surface.default.hex}}"
color-link line-number "#{{colors.on_surface_variant.default.hex}},#{{colors.surface.default.hex}}"
color-link gutter-info "#{{colors.primary.default.hex}},#{{colors.surface.default.hex}}"
color-link gutter-error "#{{colors.error.default.hex}},#{{colors.surface.default.hex}}"
color-link gutter-warning "#{{colors.tertiary.default.hex}},#{{colors.surface.default.hex}}"
color-link diff-added "#{{colors.secondary.default.hex}},#{{colors.surface.default.hex}}"
color-link diff-modified "#{{colors.tertiary.default.hex}},#{{colors.surface.default.hex}}"
color-link diff-deleted "#{{colors.error.default.hex}},#{{colors.surface.default.hex}}"
color-link cursor-line "#{{colors.on_surface.default.hex}},#{{colors.surface_container_low.default.hex}}"
color-link current-line-number "bold #{{colors.primary.default.hex}},#{{colors.surface_container_low.default.hex}}"
color-link color-column "#{{colors.on_surface_variant.default.hex}},#{{colors.surface_container.default.hex}}"
color-link ignore "#{{colors.outline.default.hex}},#{{colors.surface.default.hex}}"
color-link scrollbar "#{{colors.outline.default.hex}},#{{colors.surface.default.hex}}"
color-link divider "#{{colors.outline.default.hex}},#{{colors.surface.default.hex}}"
color-link message "#{{colors.on_surface.default.hex}},#{{colors.surface_container_high.default.hex}}"
color-link error-message "bold #{{colors.on_error.default.hex}},#{{colors.error.default.hex}}"
color-link match-brace "#{{colors.on_tertiary.default.hex}},#{{colors.tertiary.default.hex}}"
color-link hlsearch "#{{colors.on_primary.default.hex}},#{{colors.primary.default.hex}}"
color-link tab-error "underline #{{colors.error.default.hex}},#{{colors.surface.default.hex}}"
color-link trailingws "underline #{{colors.error.default.hex}},#{{colors.surface.default.hex}}"
